# Copier ce fichier vers .env et renseigner un client OAuth Google de type Application Web.
PORT=3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mode partagé / add-on : renseigner une URL HTTPS racine et le propriétaire.
MULTI_USER=false
APP_URL=http://localhost:3001
OWNER_EMAIL=
LISTEN_HOST=127.0.0.1
# DATA_DIR=/data
